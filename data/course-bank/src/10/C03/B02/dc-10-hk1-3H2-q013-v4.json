tyle=\"true\"><mn>47</mn><mn>2</mn></mfrac><mo>−</mo><mn>12</mn><mo stretchy=\"true\" form=\"postfix\">)</mo></mrow><mrow><mo stretchy=\"true\" form=\"prefix\">(</mo><mfrac displaystyle=\"true\"><mn>47</mn><mn>2</mn></mfrac><mo>−</mo><mn>15</mn><mo stretchy=\"true\" form=\"postfix\">)</mo></mrow><mrow><mo stretchy=\"true\" form=\"prefix\">(</mo><mfrac displaystyle=\"true\"><mn>47</mn><mn>2</mn></mfrac><mo>−</mo><mn>20</mn><mo stretchy=\"true\" form=\"postfix\">)</mo></mrow></mrow></msqrt><mo>=</mo><mfrac displaystyle=\"true\"><msqrt><mn>128639</mn></msqrt><mn>4</mn></mfrac><mo>≈</mo><mn>89</mn><mo>,</mo><mn>67</mn></mrow></semantics></math>.</li></ol>",
