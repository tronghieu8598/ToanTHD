</mn><mo>∘</mo></msup><mo>&lt;</mo><mover><mi>A</mi><mo accent=\"true\">̂</mo></mover><mo>&lt;</mo><msup><mn>90</mn><mo>∘</mo></msup></mrow></semantics></math> nên <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo>sin</mo><mi>A</mi><mo>&gt;</mo><mn>0</mn></mrow></semantics></math> hay <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo>sin</mo><mi>A</mi><mo>=</mo><mfrac displaystyle=\"true\"><mn>4</mn><mn>5</mn></mfrac></mrow></semantics></math>.</li></ol>",
