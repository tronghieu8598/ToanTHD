  "prompt": "<div class=\"with-figure\"><div>Một dòng sông chảy từ phía Bắc xuống phía Nam với vận tốc là <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mn>5</mn></semantics></math> km/h. Một chiếc ca nô chuyển động từ phía Đông sang phía Tây với vận tốc <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mn>45</mn></semantics></math> km/h so với mặt nước. Tìm vận tốc của ca nô so với bờ sông.<div class=\"paragraph-gap\"></div></div><div class=\"side-figure\"><figure class=\"tex-figure\"><img src=\"/bank-assets/5bd13bb160d2b54c9615b1b9a418930007db85e98926902af4413beac26d4791.svg\" alt=\"Hình minh họa\" loading=\"lazy\"><span class=\"figure-zoom\" aria-hidden=\"true\">⤢</span></figure></div></div>",
  "choices": [
    {
      "key": "A",
      "text": "<math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>4</mn><msqrt><mn>82</mn></msqrt></mrow></semantics></math>"
    },
    {
      "key": "B",
      "text": "<math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>5</mn><msqrt><mn>82</mn></msqrt></mrow></semantics></math>"
    },
    {
      "key": "C",
      "text": "<math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>5</mn><msqrt><mn>53</mn></msqrt></mrow></semantics></math>"
    },
    {
      "key": "D",
      "text": "<math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>4</mn><msqrt><mn>53</mn></msqrt></mrow></semantics></math>"
