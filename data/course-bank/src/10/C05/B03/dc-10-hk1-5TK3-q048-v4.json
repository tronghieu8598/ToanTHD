tfix\">)</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>6</mn><mo>⋅</mo><msup><mrow><mo stretchy=\"true\" form=\"prefix\">(</mo><mn>10</mn><mo>−</mo><mn>8</mn><mo>,</mo><mn>35</mn><mo stretchy=\"true\" form=\"postfix\">)</mo></mrow><mn>2</mn></msup></mrow><mn>40</mn></mfrac><mo>=</mo><mn>2</mn><mo>,</mo><mn>05</mn><mi>.</mi></mrow></semantics></math></div>\n\t\t\tVậy <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>s</mi><mi>B</mi></msub><mo>=</mo><msqrt><msubsup><mi>s</mi><mi>B</mi><mn>2</mn></msubsup></msqrt><mo>≈</mo><mn>1</mn><mo>,</mo><mn>43</mn></mrow></semantics></math>. <br>Vậy <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>s</mi><mi>B</mi></msub><mo>&gt;</mo><msub><mi>s</mi><mi>A</mi></msub></mrow></semantics></math> nên điểm bài kiểm tra môn Toán của lớp <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>10</mn><mi>A</mi></mrow></semantics></math> đồng đều hơn các bạn lớp <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>10</mn><mi>B</mi></mrow></semantics></math>.</li></ol>",
