t mathvariant=\"normal\">A</mtext></msub></msub><mo>=</mo><msub><mi>Q</mi><mn>3</mn></msub><mo>−</mo><msub><mi>Q</mi><mn>1</mn></msub><mo>=</mo><mn>385</mn><mo>−</mo><mn>270</mn><mo>=</mo><mn>115</mn></mrow></semantics></math>.</li></ul></li><li>Xét mẫu số liệu bệnh nhân B, ta có\n\t\t\t<ul class=\"\"><li>Khoảng biến thiên của mẫu số liệu là <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><msub><mi>R</mi><mtext mathvariant=\"normal\">B</mtext></msub><mo>=</mo><mn>480</mn><mo>−</mo><mn>180</mn><mo>=</mo><mn>300</mn></mrow></semantics></math>.</li><li>Cỡ mẫu là <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><msub><mi>n</mi><mtext mathvariant=\"normal\">B</mtext></msub><mo>=</mo><mn>2</mn><mo>+</mo><mn>9</mn><mo>+</mo><mn>12</mn><mo>+</mo><mn>5</mn><mo>+</mo><mn>2</mn><mo>=</mo><mn>30</mn></mrow></semantics></math>.</li><li>Gọi <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><msub><mi>x</mi><mn>1</mn></msub></semantics></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><msub><mi>x</mi><mn>2</mn></msub></semantics></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><msub><mi>x</mi><mn>3</mn></msub></semantics></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mi>…</mi></semantics></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><msub><mi>x</mi><mn>30</mn></msub></semantics></math> là thời gian ngủ hằng đêm (đơn vị: phút) của bệnh nhân B trong một tháng được sắp xếp theo thứ tự không giảm.<br>\n\t\t\t\tTứ phân vị thứ nhất của mẫu số liệu gốc là <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><msub><mi>x</mi><mn>8</mn></msub><mo>∈</mo><mo stretchy=\"false\" form=\"prefix\">[</mo><mn>240</mn><mo>;</mo><mn>300</mn><mo stretchy=\"false\" form=\"postfix\">)</mo></mrow></se