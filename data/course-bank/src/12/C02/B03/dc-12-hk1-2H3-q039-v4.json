></mrow></mrow><mn>3</mn></mfrac><mo>;</mo><mfrac><mrow><mo>−</mo><mn>2</mn><mo>+</mo><mn>2</mn><mo>+</mo><mn>3</mn></mrow><mn>3</mn></mfrac><mo>;</mo><mfrac><mrow><mn>0</mn><mo>+</mo><mn>4</mn><mo>+</mo><mn>2</mn></mrow><mn>3</mn></mfrac><mo stretchy=\"true\" form=\"postfix\">)</mo></mrow><mrow><mspace width=\"0.333em\"/><mtext mathvariant=\"normal\"> hay </mtext><mspace width=\"0.333em\"/></mrow><mi>G</mi><mrow><mo stretchy=\"true\" form=\"prefix\">(</mo><mo>−</mo><mn>2</mn><mo>;</mo><mn>1</mn><mo>;</mo><mn>2</mn><mo stretchy=\"true\" form=\"postfix\">)</mo></mrow><mi>.</mi></mrow></semantics></math></div></li><li>Sai. Để <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mi>A</mi><mi>B</mi><mi>C</mi><mi>D</mi></mrow></semantics></math> là hình bình hành thì điểm <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mi>D</mi></semantics></math> phải thoả mãn điều kiện <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mover><mrow><mi>A</mi><mi>B</mi></mrow><mo accent=\"true\">→</mo></mover><mo>=</mo><mover><mrow><mi>D</mi><mi>C</mi></mrow><mo accent=\"true\">→</mo></mover></mrow></semantics></math>. <br>\n\t\t\tGọi <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mo stretchy=\"true\" form=\"prefix\">(</mo><msub><mi>x</mi><mi>D</mi></msub><mo>;</mo><msub><mi>y</mi><mi>D</mi></msub><mo>;</mo><msub><mi>z</mi><mi>D</mi></msub><mo stretchy=\"true\" form=\"postfix\">)</mo></mrow></semantics></math> là tọa độ điểm <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mi>D</mi></semantics></math>. Ta có\n\t\t\t<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mover><mrow><mi>D</mi><mi>C</mi></mrow><mo accent=\"true\">→</mo></mover><mo>=</mo><mrow><mo stretchy=\"true\" form=\"prefix\">(</mo><mo>−</mo><mn>4</mn><mo>−</mo><msub><mi>x</mi><mi>D</mi></msub><mo>;</mo><mn>3</