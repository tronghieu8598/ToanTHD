><mn>1</mn></msub></mrow><mo accent=\"true\">→</mo></mover><mo>+</mo><mover><mrow><mi>O</mi><msub><mi>A</mi><mn>2</mn></msub></mrow><mo accent=\"true\">→</mo></mover><mo>+</mo><mover><mrow><mi>O</mi><msub><mi>A</mi><mn>3</mn></msub></mrow><mo accent=\"true\">→</mo></mover><mo>=</mo><mn>3</mn><mover><mrow><mi>O</mi><msub><mi>I</mi><mn>1</mn></msub></mrow><mo accent=\"true\">→</mo></mover><mo>=</mo><mover><mi>P</mi><mo accent=\"true\">→</mo></mover></mrow></semantics></math>,<br>\n\t\tvới <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><msub><mi>I</mi><mn>1</mn></msub></semantics></math> là trọng tâm của tam giác <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><msub><mi>A</mi><mn>1</mn></msub><msub><mi>B</mi><mn>1</mn></msub><msub><mi>C</mi><mn>1</mn></msub></mrow></semantics></math> và <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mrow><mo stretchy=\"true\" form=\"prefix\">|</mo><mover><mi>P</mi><mo accent=\"true\">→</mo></mover><mo stretchy=\"true\" form=\"postfix\">|</mo></mrow><mo>=</mo><mn>24</mn></mrow></semantics></math> N. <br>\n\t\tSuy ra <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mrow><mo stretchy=\"true\" form=\"prefix\">|</mo><mover><mrow><mi>O</mi><msub><mi>I</mi><mn>1</mn></msub></mrow><mo accent=\"true\">→</mo></mover><mo stretchy=\"true\" form=\"postfix\">|</mo></mrow><mo>=</mo><mfrac displaystyle=\"true\"><mn>24</mn><mn>3</mn></mfrac><mo>=</mo><mn>8</mn></mrow></semantics></math> N.<br>\n\t\tTa có <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mi>I</mi></semantics></math> là tâm của chiếc đèn. Mà tam giác <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mi>A</mi><mi>B</mi><mi>C</mi></mrow></semantics></math> đều nên <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mi>I</mi></semantics></math> cũng là trọng tâm tam giác <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mi>A</mi><mi>B</mi><mi>C</mi></mrow></semantics></math>.<br>\n\t\tKhi đó <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mfrac displaystyle=\"true\"><mrow><mo stretchy=\"true\" form=\"prefix\">|</mo><mover><mrow><mi>O</mi><msub><mi>A</mi><mn>1</mn></msub></mrow><mo accent=\"true\">→</mo></mover><mo stretchy=\"true\" form=\"postfix\">|</mo></mrow><mrow><mo stretchy=\"true\" form=\"prefix\">|</mo><mover><mrow><mi>O</mi><msub><mi>I</mi><mn>1</mn></msub></mrow><mo accent=\"true\">→</mo></mover><mo stretchy=\"true\" form=\"postfix\">|</mo></mrow></mfrac><mo>=</mo><mfrac displaystyle=\"true\"><mrow><mi>O</mi><mi>A</mi></mrow><mrow><mi>O</mi><mi>I</mi></mrow></mfrac></mrow></semantics></math>. \n\t\tSuy ra <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mfrac displaystyle=\"true\"><mi>F</mi><mn>8</mn></mfrac><mo>=</mo><mfrac displaystyle=\"true\"><mrow><mi>O</mi><mi>A</mi></mrow><mrow><mi>O</mi><mi>I</mi></mrow></mfrac></mrow></semantics></math>.<br>\n\t\tMà ta có <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mi>O</mi><mi>A</mi><mo>=</mo><mi>L</mi></mrow></semantics></math> in, <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mi>O</mi><mi>I</mi><mo>=</mo><msqrt><mrow><mi>O</mi><msup><mi>A</mi><mn>2</mn></msup><mo>−</mo><mi>A</mi><msup><mi>I</mi><mn>2</mn></msup></mrow></msqrt><mo>=</mo><msqrt><mrow><msup><mi>L</mi><mn>2</mn></msup><mo>−</mo><msup><mn>18</mn><mn>2</mn></msup></mrow></msqrt></mrow></semantics></math> in.<br>\n\t\tNên <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mfrac displaystyle=\"true\"><mi>F</mi><mn>8</mn></mfrac><mo>=</mo><mfrac displaystyle=\"true\"><mi>L</mi><msqrt><mrow><msup><mi>L</mi><mn>2</mn></msup><mo>−</mo><msup><mn>18</mn><mn>2</mn></msup></mrow></msqrt></mfrac></mrow></semantics></math>.<br>\n\t\tTừ đó suy ra <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mi>F</mi><mo>=</mo><mfrac displaystyle=\"true\"><mrow><mn>8</mn><mi>L</mi></mrow><msqrt><mrow><msup><mi>L</mi><mn>2</mn></msup><mo>−</mo><msup><mn>18</mn><mn>2</mn></msup></mrow></msqrt></mfrac></mrow></semantics></math> N.<br>\n\t\tHàm số <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mi>F</mi><mo>=</mo><mfrac displaystyle=\"true\"><mrow><mn>8</mn><mi>L</mi></mrow><msqrt><mrow><msup><mi>L</mi><mn>2</mn></msup><mo>−</mo><msup><mn>18</mn><mn>2</mn></msup></mrow></msqrt></mfrac></mrow></semantics></math> xác định trên <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mo stretchy=\"true\" form=\"prefix\">(</mo><mn>18</mn><mo>;</mo><mo>+</mo><mi>∞</mi><mo stretchy=\"true\" form=\"postfix\">)</mo></mrow></semantics></math>. <br>\n\t\tTa có \n\t\t<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mi>F</mi><mi>′</mi><mo>=</mo><mfrac displaystyle=\"true\"><mrow><mo>−</mo><mn>2592</mn></mrow><mrow><mrow><mo stretchy=\"true\" form=\"prefix\">(</mo><msup><mi>L</mi><mn>2</mn></msup><mo>−</mo><msup><mn>18</mn><mn>2</mn></msup><mo stretchy=\"true\" form=\"postfix\">)</mo></mrow><msqrt><mrow><msup><mi>L</mi><mn>2</mn></msup><mo>−</mo><msup><mn>18</mn><mn>2</mn></msup></mrow></msqrt></mrow></mfrac><mo>&lt;</mo><mn>0</mn></mrow></semantics></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mo>∀</mo><mi>L</mi><mo>∈</mo><mrow><mo stretchy=\"true\" form=\"prefix\">(</mo><mn>18</mn><mo>;</mo><mo>+</mo><mi>∞</mi><mo stretchy=\"true\" form=\"postfix\">)</mo></mrow></mrow></semantics></math>.<br>\n\t\tDo đó <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mi>F</mi></semantics></math> là hàm số nghịch biến trên tập xác định của nó.\n\t\t<ol class=\"alpha-list\"><li><strong>Sai</strong>. <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mover><msub><mi>F</mi><mn>1</mn></msub><mo accent=\"true\">→</mo></mover><mo>+</mo><mover><msub><mi>F</mi><mn>2</mn></msub><mo accent=\"true\">→</mo></mover><mo>+</mo><mover><msub><mi>F</mi><mn>3</mn></msub><mo accent=\"true\">→</mo></mover><mo>=</mo><mover><mi>P</mi><mo accent=\"true\">→</mo></mover><mo>≠</mo><mover><mn>0</mn><mo accent=\"true\">→</mo></mover></mrow></semantics></math>.</li><li><strong>Sai</strong>. <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mi>F</mi><mrow><mo stretchy=\"true\" form=\"prefix\">(</mo><mi>L</mi><mo stretchy=\"true\" form=\"postfix\">)</mo></mrow><mo>=</mo><mfrac displaystyle=\"true\"><mrow><mn>8</mn><mi>L</mi></mrow><msqrt><mrow><msup><mi>L</mi><mn>2</mn></msup><mo>−</mo><msup><mn>18</mn><mn>2</mn></msup></mrow></msqrt></mfrac></mrow></semantics></math> N.</li><li><strong>Đúng</strong>.</li><li><strong>Sai</strong>. Khi lực căng dây bằng <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mn>10</mn></semantics></math> N, ta có\n\t\t\t<div class=\"math-display\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mfrac displaystyle=\"true\"><mrow><mn>8</mn><mi>L</mi></mrow><msqrt><mrow><msup><mi>L</mi><mn>2</mn></msup><mo>−</mo><msup><mn>18</mn><mn>2</mn></msup></mrow></msqrt></mfrac><mo>=</mo><mn>10</mn><mo>⇒</mo><mn>8</mn><mi>L</mi><mo>=</mo><mn>10</mn><msqrt><mrow><msup><mi>L</mi><mn>2</mn></msup><mo>−</mo><msup><mn>18</mn><mn>2</mn></msup></mrow></msqrt><mo>⇒</mo><mi>L</mi><mo>=</mo><mn>30</mn><mrow><mspace width=\"0.333em\"/><mtext mathvariant=\"normal\"> (thỏa mãn điều kiện </mtext><mspace width=\"0.333em\"/></mrow><mi>L</mi><mo>&gt;</mo><mn>18</mn><mo stretchy=\"false\" form=\"postfix\">)</mo><mi>.</mi></mrow></semantics></math></div>\n\t\t\tVì hàm <math xmlns=\"http://www.w3.