tyle=\"true\"><mn>1</mn><msup><mi>a</mi><mn>2</mn></msup></mfrac><mo>+</mo><mfrac displaystyle=\"true\"><mn>1</mn><msup><mi>a</mi><mn>2</mn></msup></mfrac><mo>+</mo><mfrac displaystyle=\"true\"><mn>1</mn><msup><mi>a</mi><mn>2</mn></msup></mfrac><mo>=</mo><mfrac displaystyle=\"true\"><mn>3</mn><msup><mi>a</mi><mn>2</mn></msup></mfrac></mtd></mtr><mtr><mtd columnalign=\"right\" style=\"text-align: right\"><mo>⇒</mo><mi>A</mi><mi>H</mi></mtd><mtd columnalign=\"left\" style=\"text-align: left\"><mo>=</mo></mtd><mtd columnalign=\"right\" style=\"text-align: right\"><mfrac displaystyle=\"true\"><mrow><mi>a</mi><msqrt><mn>3</mn></msqrt></mrow><mn>3</mn></mfrac><mi>.</mi></mtd></mtr></mtable></semantics></math></div></li></ol></div><div class=\"side-figure\"><figure class=\"tex-figure\"><img src=\"/bank-assets/6613c2cc88b738196772d4af00b774d3eb7baaa6403fa70ce55919fa4a3b512e.svg\" alt=\"Hình minh họa\" loading=\"lazy\"><span class=\"figure-zoom\" aria-hidden=\"true\">⤢</span></figure></div></div>",
