fix\">)</mo></mrow><mo>=</mo><mi>A</mi><mi>H</mi><mi>.</mi></mrow></semantics></math><br>Tam giác <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>A</mi><mi>A</mi><mi>′</mi><mi>I</mi></mrow></semantics></math> vuông tại <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mi>I</mi></semantics></math>, có đường cao <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>A</mi><mi>H</mi></mrow></semantics></math> nên <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mfrac displaystyle=\"true\"><mn>1</mn><mrow><mi>A</mi><msup><mi>H</mi><mn>2</mn></msup></mrow></mfrac><mo>=</mo><mfrac displaystyle=\"true\"><mn>1</mn><mrow><mi>A</mi><msup><mi>I</mi><mn>2</mn></msup></mrow></mfrac><mo>+</mo><mfrac displaystyle=\"true\"><mn>1</mn><mrow><mi>A</mi><mi>A</mi><msup><mi>′</mi><mn>2</mn></msup></mrow></mfrac><mo>=</mo><mfrac displaystyle=\"true\"><mn>1</mn><msup><mn>15</mn><mn>2</mn></msup></mfrac><mo>+</mo><mfrac displaystyle=\"true\"><mn>1</mn><msup><mn>15</mn><mn>2</mn></msup></mfrac><mo>=</mo><mfrac displaystyle=\"true\"><mn>2</mn><msup><mn>15</mn><mn>2</mn></msup></mfrac><mo>⇒</mo><mi>A</mi><mi>H</mi><mo>=</mo><mfrac displaystyle=\"true\"><mrow><mn>15</mn><msqrt><mn>2</mn></msqrt></mrow><mn>2</mn></mfrac><mi>.</mi></mrow></semantics></math><br>Vậy <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi mathvariant=\"normal\">d</mi><mrow><mo stretchy=\"true\" form=\"prefix\">(</mo><mi>B</mi><mi>′</mi><mi>C</mi><mi>′</mi><mo>,</mo><mi>A</mi><mi>′</mi><mi>D</mi><mo stretchy=\"true\" form=\"postfix\">)</mo></mrow><mo>=</mo><mn>2</mn><mi mathvariant=\"normal\">d</mi><mrow><mo stretchy=\"true\" form=\"prefix\">(</mo><mi>A</mi><mo>,</mo><mrow><mo stretchy=\"true\" form=\"prefix\">(</mo><mi>A</mi><mi>′</mi><mi>D</mi><mi>I</mi><mo stretchy=\"true\" form=\"postfix\">)</mo></mrow><mo stretchy=\"true\" form=\"