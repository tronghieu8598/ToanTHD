mi><mn>2</mn></msub><msub><mi>C</mi><mn>2</mn></msub><msub><mi>D</mi><mn>2</mn></msub></mrow></semantics></math> là \n\t\t<math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>S</mi><mn>3</mn></msub><mo>=</mo><msup><mrow><mo stretchy=\"true\" form=\"prefix\">(</mo><mfrac displaystyle=\"true\"><mi>a</mi><mn>2</mn></mfrac><mo stretchy=\"true\" form=\"postfix\">)</mo></mrow><mn>2</mn></msup><mo>=</mo><mfrac displaystyle=\"true\"><msup><mi>a</mi><mn>2</mn></msup><mn>4</mn></mfrac><mi>.</mi></mrow></semantics></math><br>Dãy diện tích các hình vuông.<br>-Dãy diện tích các hình vuông lần lượt là \n\t\t<math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>S</mi><mn>1</mn></msub><mo>=</mo><msup><mi>a</mi><mn>2</mn></msup><mo>,</mo><mspace width=\"1.0em\"/><msub><mi>S</mi><mn>2</mn></msub><mo>=</mo><mfrac displaystyle=\"true\"><msup><mi>a</mi><mn>2</mn></msup><mn>2</mn></mfrac><mo>,</mo><mspace width=\"1.0em\"/><msub><mi>S</mi><mn>3</mn></msub><mo>=</mo><mfrac displaystyle=\"true\"><msup><mi>a</mi><mn>2</mn></msup><mn>4</mn></mfrac><mo>,</mo><mspace width=\"1.0em\"/><msub><mi>S</mi><mn>4</mn></msub><mo>=</mo><mfrac displaystyle=\"true\"><msup><mi>a</mi><mn>2</mn></msup><mn>8</mn></mfrac><mo>,</mo><mi>…</mi></mrow></semantics></math><br>Các diện tích này lập thành một cấp số nhân lùi vô hạn có <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>=</mo><msup><mi>a</mi><mn>2</mn></msup></mrow></semantics></math> và công bội <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>q</mi><mo>=</mo><mfrac displaystyle=\"true\"><mn>1</mn><mn>2</mn></mfrac></mrow></semantics></math> và <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>S</mi><mo>=</mo><msub><mi>S</mi><mn>1</mn></msub><mo>+</mo><msub><mi>S</mi><mn>2</mn></msub><mo>+</mo><mi>…</mi></mrow></semantics></math>. Khi đó<br><div class=\"math-display\"><math display=\"block\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>S</mi><mo>=</mo><mfrac displaystyle=\"true\"><msub><mi>u</mi><mn>1</mn></msub><mrow><mn>1</mn><mo>−</mo><mi>q</mi></mrow></mfrac><mo>=</mo><mfrac displaystyle=\"true\"><msup><mi>a</mi><mn>2</mn></msup><mrow><mn>1</mn><mo>−</mo><mfrac displaystyle=\"false\"><mn>1</mn><mn>2</mn></mfrac></mrow></mfrac><mo>=</mo><mn>2</mn><msup><mi>a</mi><mn>2</mn></msup><mo>=</mo><mn>18</mn><mo>⇒</mo><mi>a</mi><mo>=</mo><mn>3</mn><mi>.</mi></mrow></semantics></math></div>",
