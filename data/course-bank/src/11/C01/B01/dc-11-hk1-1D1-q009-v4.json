  "prompt": "Biểu diễn các góc lượng giác sau trên đường tròn lượng giác:\n\t<ol class=\"alpha-list\"><li><math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mfrac displaystyle=\"true\"><mrow><mo>−</mo><mn>17</mn><mi>π</mi></mrow><mn>3</mn></mfrac></semantics></math>;</li><li><math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mfrac displaystyle=\"true\"><mrow><mn>13</mn><mi>π</mi></mrow><mn>4</mn></mfrac></semantics></math>;</li><li><math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo>−</mo><msup><mn>765</mn><mo>∘</mo></msup></mrow></semantics></math>.</li></ol>",
  "choices": [],
