o>−</mo><mn>5</mn><mo>=</mo><mfrac displaystyle=\"true\"><mi>π</mi><mn>3</mn></mfrac><mo>+</mo><mi>k</mi><mi>π</mi></mtd></mtr><mtr><mtd columnalign=\"right\" style=\"text-align: right\"/><mtd columnalign=\"left\" style=\"text-align: left\"><mo>⇔</mo></mtd><mtd columnalign=\"right\" style=\"text-align: right\"><mi>x</mi><mo>=</mo><mfrac displaystyle=\"true\"><mn>5</mn><mn>2</mn></mfrac><mo>+</mo><mfrac displaystyle=\"true\"><mi>π</mi><mn>6</mn></mfrac><mo>+</mo><mi>k</mi><mfrac displaystyle=\"true\"><mi>π</mi><mn>2</mn></mfrac><mo>,</mo><mspace width=\"0.222em\"/><mi>k</mi><mo>∈</mo><mi>ℤ</mi><mi>.</mi></mtd></mtr></mtable></semantics></math></div>\n\t\t\tTa có <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy=\"true\" form=\"prefix\">(</mo><mn>0</mn><mo>;</mo><mn>3</mn><mi>π</mi><mo stretchy=\"true\" form=\"postfix\">)</mo></mrow><mo>⇒</mo><mn>0</mn><mo>&lt;</mo><mfrac displaystyle=\"true\"><mn>5</mn><mn>2</mn></mfrac><mo>+</mo><mfrac displaystyle=\"true\"><mi>π</mi><mn>6</mn></mfrac><mo>+</mo><mi>k</mi><mfrac displaystyle=\"true\"><mi>π</mi><mn>2</mn></mfrac><mo>&lt;</mo><mn>3</mn><mi>π</mi><mo>⇔</mo><mo>−</mo><mfrac displaystyle=\"true\"><mn>5</mn><mi>π</mi></mfrac><mo>−</mo><mfrac displaystyle=\"true\"><mn>1</mn><mn>3</mn></mfrac><mo>&lt;</mo><mi>k</mi><mo>&lt;</mo><mn>6</mn><mo>−</mo><mfrac displaystyle=\"true\"><mn>5</mn><mi>π</mi></mfrac><mo>−</mo><mfrac displaystyle=\"true\"><mn>1</mn><mn>3</mn></mfrac></mrow></semantics></math>.<br>Mà <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi><mo>⇒</mo><mi>k</mi><mo>∈</mo><mo stretchy=\"false\" form=\"prefix\">{</mo><mo>−</mo><mn>1</mn><mo>;</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>;</mo><mn>2</mn><mo>;</mo><mn>3</mn><mo>;</mo><mn>4</mn><mo stretchy=\"false\" form=\"postfix\">}</mo></mrow></semantics></math>.<br>Vậy phương trình có <math display=\"inline\" xmlns=\"http://www.w3.