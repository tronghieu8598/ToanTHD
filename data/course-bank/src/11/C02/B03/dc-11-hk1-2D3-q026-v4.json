">(</mo><mn>0</mn><mo>,</mo><mn>6</mn><mo stretchy=\"true\" form=\"postfix\">)</mo></mrow><mn>4</mn></msup><mo stretchy=\"true\" form=\"postfix\">]</mo></mrow><mo>=</mo><mn>9</mn><mo>⋅</mo><mfrac displaystyle=\"true\"><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy=\"true\" form=\"prefix\">(</mo><mn>0</mn><mo>,</mo><mn>6</mn><mo stretchy=\"true\" form=\"postfix\">)</mo></mrow><mn>5</mn></msup></mrow><mrow><mn>1</mn><mo>−</mo><mn>0</mn><mo>,</mo><mn>6</mn></mrow></mfrac><mo>=</mo><mn>20</mn><mo>,</mo><mn>75</mn></mrow></semantics></math> m.</li></ol>",
