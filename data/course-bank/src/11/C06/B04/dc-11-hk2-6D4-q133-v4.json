olumnalign=\"right\" style=\"text-align: right\"><msub><mo>log</mo><mn>3</mn></msub><mrow><mo stretchy=\"true\" form=\"prefix\">(</mo><mn>4</mn><mi>m</mi><mo>−</mo><mn>1</mn><mo stretchy=\"true\" form=\"postfix\">)</mo></mrow><mo>=</mo><mn>3</mn></mtd></mtr><mtr><mtd columnalign=\"right\" style=\"text-align: right\"/><mtd columnalign=\"left\" style=\"text-align: left\"><mo>⇔</mo></mtd><mtd columnalign=\"right\" style=\"text-align: right\"><mn>4</mn><mi>m</mi><mo>−</mo><mn>1</mn><mo>=</mo><msup><mn>3</mn><mn>3</mn></msup></mtd></mtr><mtr><mtd columnalign=\"right\" style=\"text-align: right\"/><mtd columnalign=\"left\" style=\"text-align: left\"><mo>⇔</mo></mtd><mtd columnalign=\"right\" style=\"text-align: right\"><mi>m</mi><mo>=</mo><mn>7</mn><mi>.</mi></mtd></mtr></mtable></semantics></math></div>",
