lay=\"inline\"><semantics><mrow><mi>A</mi><mi>E</mi><mo>⊥</mo><mrow><mo stretchy=\"true\" form=\"prefix\">(</mo><mi>A</mi><mi>B</mi><mi>C</mi><mi>D</mi><mo stretchy=\"true\" form=\"postfix\">)</mo></mrow></mrow></semantics></math> nên <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><semantics><mrow><mi>A</mi><mi>G</mi><mo>=</mo><msqrt><mrow><msup><mrow><mi>A</mi><mi>C</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>A</mi><mi>E</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></msqrt><mo>≈</mo><mn>34</mn><mo>,</mo><mn>6</mn></mrow></semantics></math> N.</div><div class=\"side-figure\"><figure class=\"tex-figure\"><img src=\"/variant-assets/ee29c1b604cf723c1268878a662893735dbe322bc57b7f75137aee6c88a839f7.svg\" alt=\"Hình minh họa\" loading=\"lazy\"><span class=\"figure-zoom\" aria-hidden=\"true\">⤢</span></figure></div></div>",
